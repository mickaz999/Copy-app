generator client {
  provider = "prisma-client-js"
}

// Base Postgres (Neon). La même URL sert en local et en ligne :
// colle-la dans DATABASE_URL (.env en local, réglages Vercel en ligne).
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Page {
  id        String   @id @default(cuid())
  title     String   @default("Sans titre")
  icon      String   @default("📄")
  content   String   @default("[]") // blocs JSON
  parentId  String?
  parent    Page?    @relation("Tree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Page[]   @relation("Tree")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id        String    @id @default(cuid())
  title     String
  notes     String    @default("")
  status    String    @default("todo") // todo | doing | done
  category  String    @default("Créa")
  date      DateTime?
  endDate   DateTime? // fin, pour une tâche sur plusieurs jours
  startTime String    @default("") // horaire facultatif "HH:MM" (tâche d'un seul jour)
  endTime   String    @default("")
  blockEventId String  @default("") // créneau bloqué dans Google Agenda pour cette tâche
  blockCalId   String  @default("")
  repeat        String    @default("") // "" | daily | every2days | every3days | weekdays | weekly | biweekly | monthly
  repeatUntil   DateTime?
  repeatSpawned Boolean   @default(false) // la tâche suivante a déjà été créée
  props     String    @default("{}") // valeurs des propriétés perso (JSON)
  subtasks  String    @default("[]") // sous-tâches (JSON [{ id, title, done }])
  deliveryId String   @default("") // livraison client liée (tâche « Modifs ») ; sous-tâche "c:<id>" = retour client
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Transaction {
  id        String   @id @default(cuid())
  date      DateTime
  label     String
  kind      String   // recette | depense
  amount    Float
  category  String   @default("")
  client    String   @default("")
  payment   String   @default("Virement")
  reference String   @default("") // n° de facture
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id       Int    @id @default(1)
  rate     Float  @default(24.6) // taux de cotisations URSSAF (%)
  ceiling  Float  @default(77700) // plafond de CA micro
  activity String @default("BNC - prestations de services")
}

// Agenda externe (Google, Apple, Outlook…) lu via son adresse iCal
model Calendar {
  id        String   @id @default(cuid())
  name      String
  url       String
  color     String   @default("#2383e2")
  createdAt DateTime @default(now())
}

// Compte Google connecté (API Google Agenda, lecture + écriture)
model GoogleAccount {
  id           String      @id @default(cuid())
  email        String      @unique
  refreshToken String
  accessToken  String      @default("")
  expiresAt    DateTime    @default(now())
  scopes       String      @default("") // autorisations accordées (ex. envoi de mails)
  calendars    GoogleCal[]
  createdAt    DateTime    @default(now())
}

model GoogleCal {
  id         String        @id @default(cuid())
  accountId  String
  account    GoogleAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  calendarId String
  name       String
  color      String        @default("#2383e2")
  visible    Boolean       @default(true)
  writable   Boolean       @default(false)

  @@unique([accountId, calendarId])
}

// Propriété personnalisée des tâches (colonne de la vue Liste)
model TaskProperty {
  id        String   @id @default(cuid())
  name      String
  type      String   // text | number | select | multi | date | checkbox | url
  options   String   @default("[]") // choix possibles (JSON) pour select / multi
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// Abonnement aux notifications push d'un appareil (téléphone, ordinateur)
model PushSub {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  device    String   @default("")
  createdAt DateTime @default(now())
}

// Réglages des notifications et des mails
model NotifSettings {
  id             Int     @id @default(1)
  reviewUrl      String  @default("https://search.google.com/local/writereview?placeid=ChIJRQLTsr-rF2IRtzKgJwgr-nA") // lien « laisser un avis Google » montré aux clients
  pushEnabled    Boolean @default(true)
  emailEnabled   Boolean @default(true)
  emailTo        String  @default("")
  digestHour     Int     @default(8)   // heure du récap du matin (heure de Paris)
  eventReminder  Int     @default(30)  // minutes avant un RDV (0 = pas de rappel)
  lateAlert      Boolean @default(true)
  lastDigestDate String  @default("")  // dernier récap envoyé (YYYY-MM-DD)
  liveCalendar   String  @default("")  // agenda des lives à surveiller (id GoogleCal ou Calendar)
  liveDays       Int     @default(3)   // nombre de jours à couvrir
  liveCategory   String  @default("Gaming")
  blockCalendar  String  @default("")  // agenda Google où bloquer les tâches avec horaire
  mailAccount    String  @default("")  // compte Google (GoogleAccount.id) qui envoie les mails ; vide = le premier connecté
}

// Rappels déjà envoyés, pour ne jamais notifier deux fois
model SentReminder {
  key       String   @id
  createdAt DateTime @default(now())
}

// Musique d'inspiration (liens YouTube)
model Track {
  id        String   @id @default(cuid())
  url       String
  videoId   String   @default("")
  start     Int      @default(0) // seconde de départ (ex. ?t=405)
  title     String   @default("")
  author    String   @default("")
  mood      String   @default("") // ambiance / tags
  notes     String   @default("")
  createdAt DateTime @default(now())
}

// Espace d'inspiration : une toile de blocs reliés (stockée en JSON : { nodes, edges, view })
model Board {
  id        String   @id @default(cuid())
  name      String   @default("Nouvel espace")
  data      String   @default("{\"nodes\":[],\"edges\":[]}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Fichiers des espaces inspi (vocaux, images importées), stockés à part pour garder les toiles légères
model Media {
  id        String   @id @default(cuid())
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
}

// Comptes connectés pour les stats avancées du rapport hebdo (youtube, twitch)
model ApiToken {
  provider     String   @id
  refreshToken String
  accessToken  String   @default("")
  expiresAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Nombre de spectateurs Twitch relevé toutes les 5 min pendant les lives
model TwitchSample {
  id       String   @id @default(cuid())
  streamId String
  at       DateTime @default(now())
  viewers  Int
  title    String   @default("")
  game     String   @default("")

  @@index([at])
}

// Prise de RDV publique (/rdv/<slug>) : horaires proposés, croisés avec les agendas
model BookingSettings {
  id        Int     @id @default(1)
  enabled   Boolean @default(false)
  slug      String  @default(cuid()) // partie secrète du lien à partager
  title     String  @default("Prendre rendez-vous")
  intro     String  @default("")
  duration  Int     @default(30)  // durée d'un RDV (min)
  step      Int     @default(30)  // intervalle entre deux débuts de créneau (min)
  buffer    Int     @default(0)   // marge libre avant / après chaque événement (min)
  minNotice Int     @default(12)  // délai minimum avant un RDV (heures)
  maxDays   Int     @default(30)  // jusqu'à combien de jours à l'avance
  hours     String  @default("{\"1\":[[\"09:00\",\"18:00\"]],\"2\":[[\"09:00\",\"18:00\"]],\"3\":[[\"09:00\",\"18:00\"]],\"4\":[[\"09:00\",\"18:00\"]],\"5\":[[\"09:00\",\"18:00\"]]}") // plages par jour (0 = dimanche), heure de Paris
  calendar  String  @default("")  // agenda Google (GoogleCal.id) où créer les RDV
  location  String  @default("")
  blocked   String  @default("[]") // jours fermés aux RDV (JSON ["YYYY-MM-DD", …])
  visioLink String  @default("")  // lien visio fixe ; vide = un lien Meet créé pour chaque RDV
}

// RDV pris via le lien public (lié à l'événement Google créé)
model Appointment {
  id        String   @id @default(cuid())
  token     String   @unique // lien « gérer mon RDV » envoyé à la personne
  name      String
  email     String   @default("")
  phone     String   @default("")
  mode      String   @default("visio") // visio | whatsapp
  note      String   @default("")
  day       String   // YYYY-MM-DD (heure de Paris)
  time      String   // HH:MM
  end       String
  start     DateTime // instant de début, pour trier
  meet      String   @default("")
  calId     String   // GoogleCal.id
  eventId   String
  status    String   @default("confirmed") // confirmed | cancelled
  createdAt DateTime @default(now())

  @@index([start])
}

// Livraison client : page publique (/l/<token>) qui lit des vidéos hébergées sur Frame.io
model Delivery {
  id         String   @id @default(cuid())
  token      String   @unique
  title      String
  client     String   @default("")
  message    String   @default("") // mot affiché au client en haut de la page
  accountId  String   // compte Frame.io
  files      String   @default("[]") // versions, de la plus ancienne à la plus récente (JSON [{ fileId, name }])
  download   Boolean  @default(true) // téléchargement autorisé
  dlApproved Boolean  @default(true) // ancien réglage, remplacé par dlMode
  dlMode     String   @default("approved") // téléchargement : approved = après validation (défaut, y compris livraisons existantes) | always | never
  kind       String   @default("versions") // versions = V1, V2… d'une même vidéo ; videos = plusieurs vidéos différentes ; folder = dossier Frame.io (sous-dossiers compris)
  folderId   String   @default("")         // dossier Frame.io livré (kind = folder)
  approved   String   @default("[]")       // vidéos validées (kind = videos), numéros
  mode       String   @default("page") // page = lien maderino ; frame = suivi des commentaires Frame.io seulement (agences)
  tasks      String   @default("{}")   // tâche « Modifs » liée par version ({ "1": taskId })
  networks   String   @default("[]")
  feedback   String   @default("ask") // retours client : open = toujours visibles | ask = sur demande (bouton) | off = désactivés // aperçus proposés (reel, tiktok, short, youtube) ; vide = selon le format
  approvedAt DateTime?
  expiresAt  DateTime? // fin de validité du lien (vide = 1 mois après la création)
  approvedV  Int      @default(0)    // numéro de la version validée
  createdAt  DateTime @default(now())
  comments   DeliveryComment[]
}

model DeliveryComment {
  id         String   @id @default(cuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  version    Int      // 1 = V1
  author     String
  text       String
  time       Float?   // seconde de la vidéo (commentaire horodaté)
  resolved   Boolean  @default(false)
  source     String   @default("page") // page | frame
  externalId String   @default("")     // id du commentaire Frame.io
  fileId     String   @default("")     // fichier commenté (livraison d'un dossier)
  audio      String   @default("")     // message vocal (Media.id)
  fileName   String   @default("")
  createdAt  DateTime @default(now())
}

// Lien de dépôt de rushs : le client envoie ses fichiers directement dans un dossier Frame.io
model DropLink {
  id         String     @id @default(cuid())
  token      String     @unique
  title      String
  client     String     @default("")
  message    String     @default("")
  accountId  String
  folderId   String     // dossier Frame.io de destination
  folderName String     @default("")
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  files      DropFile[]
}

model DropFile {
  id        String   @id @default(cuid())
  linkId    String
  link      DropLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  name      String
  size      Float
  fileId    String   @default("")
  author    String   @default("")
  createdAt DateTime @default(now())
}
